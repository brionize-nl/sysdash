# ── SysDash v12 · secrets-sjabloon ──
# Kopieer naar .env en vul in. .env staat op .gitignore → komt NOOIT online.

# Supabase (project "SysDash-Health")
SUPABASE_URL=https://JOUW-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=            # server-side, ALLEEN op je machines (agent schrijft hiermee)
SUPABASE_ANON_KEY=               # read-only, mag in de web-app

# Discord
DISCORD_WEBHOOK=                 # https://discord.com/api/webhooks/....

# Deze machine (wordt door de installer gezet)
MACHINE_NAME=                    # bv. delli5 of pro
