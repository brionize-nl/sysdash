# Voorbeeld; gebruik de begeleide installer voor rollen, modi en rechten.
# SysDash actions-gateway (trede 2+3, Tailscale-only) — systemd. Installer vult sysdash//opt/sysdash in.
[Unit]
Description=SysDash actions-gateway (opschoning + herstart vanaf het dashboard, Tailscale-only)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=sysdash
WorkingDirectory=/opt/sysdash
EnvironmentFile=/etc/sysdash/sysdash.env
ExecStart=/opt/sysdash/.venv/bin/python /opt/sysdash/actions/actions-gateway.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
