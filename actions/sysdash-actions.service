# SysDash actie-runner (zelf-herstel) — systemd. Installer vult __USER__/__DIR__ in.
[Unit]
Description=SysDash actie-runner (trede 1: zelf-herstel)
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
ExecStart=/usr/bin/python3 __DIR__/actions/action-runner.py
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
