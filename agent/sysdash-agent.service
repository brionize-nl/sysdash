# Voorbeeld; gebruik de begeleide installer voor rollen, modi en rechten.
# SysDash agent — systemd unit. De installer vult sysdash en /opt/sysdash in.
[Unit]
Description=SysDash agent (metrics naar Supabase)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sysdash
WorkingDirectory=/opt/sysdash
EnvironmentFile=/etc/sysdash/sysdash.env
ExecStart=/opt/sysdash/.venv/bin/python /opt/sysdash/agent/agent.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
