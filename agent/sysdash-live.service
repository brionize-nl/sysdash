# Voorbeeld; gebruik de begeleide installer voor rollen, modi en rechten.
# SysDash live-hartslag — systemd unit. Installer vult sysdash en /opt/sysdash in.
[Unit]
Description=SysDash live-hartslag (~2s)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sysdash
WorkingDirectory=/opt/sysdash
EnvironmentFile=/etc/sysdash/sysdash.env
ExecStart=/opt/sysdash/.venv/bin/python /opt/sysdash/agent/agent.py --live
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
