# SysDash live-hartslag — systemd unit. Installer vult __USER__ en __DIR__ in.
[Unit]
Description=SysDash live-hartslag (~2s)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
ExecStart=/usr/bin/python3 __DIR__/agent/agent.py --live
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
