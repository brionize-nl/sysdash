# Voorbeeld; gebruik de begeleide installer voor rollen, modi en rechten.
# SysDash boot/shutdown-melding — systemd unit. Installer vult sysdash en /opt/sysdash in.
[Unit]
Description=SysDash boot/shutdown-melding naar Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=sysdash
WorkingDirectory=/opt/sysdash
EnvironmentFile=/etc/sysdash/sysdash.env
ExecStart=/bin/bash /opt/sysdash/boot-notify/sysdash-boot-notify.sh up
ExecStop=/bin/bash /opt/sysdash/boot-notify/sysdash-boot-notify.sh down

[Install]
WantedBy=multi-user.target
