# SysDash boot/shutdown-melding — systemd unit. Installer vult __USER__ en __DIR__ in.
[Unit]
Description=SysDash boot/shutdown-melding naar Discord
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
ExecStart=/bin/bash __DIR__/boot-notify/sysdash-boot-notify.sh up
ExecStop=/bin/bash __DIR__/boot-notify/sysdash-boot-notify.sh down

[Install]
WantedBy=multi-user.target
