# Voorbeeld; gebruik de begeleide installer voor rollen, modi en rechten.
# SysDash 2x-daags overzicht — systemd unit. De installer vult sysdash en /opt/sysdash in.
[Unit]
Description=SysDash 2x-daags overzicht (12u in 6x2u-blokken naar Discord)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=sysdash
WorkingDirectory=/opt/sysdash
EnvironmentFile=/etc/sysdash/sysdash.env
ExecStart=/opt/sysdash/.venv/bin/python /opt/sysdash/overview/sysdash-overview.py
