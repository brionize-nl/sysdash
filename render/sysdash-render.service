# Voorbeeld; gebruik de begeleide installer voor rollen, modi en rechten.
# SysDash render-service — systemd unit. Installer vult sysdash en /opt/sysdash in.
[Unit]
Description=SysDash render-service (HUD-kaart voor Discord)
After=network.target

[Service]
Type=simple
User=sysdash
WorkingDirectory=/opt/sysdash
ExecStart=/opt/sysdash/.venv/bin/python /opt/sysdash/render/render.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
