# Voorbeeld; gebruik de begeleide installer voor rollen, modi en rechten.
# SysDash Quick Tunnel — systemd unit. Installer vult sysdash en /opt/sysdash in.
[Unit]
Description=SysDash Quick Tunnel (https voor dashboard)
After=network-online.target sysdash-web.service
Wants=network-online.target

[Service]
Type=simple
User=sysdash
WorkingDirectory=/opt/sysdash
EnvironmentFile=/etc/sysdash/sysdash.env
ExecStart=/bin/bash /opt/sysdash/tunnel/sysdash-tunnel.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
