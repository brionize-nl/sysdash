# SysDash Quick Tunnel — systemd unit. Installer vult __USER__ en __DIR__ in.
[Unit]
Description=SysDash Quick Tunnel (https voor dashboard)
After=network-online.target sysdash-web.service
Wants=network-online.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__DIR__
EnvironmentFile=__DIR__/.env
ExecStart=/bin/bash __DIR__/tunnel/sysdash-tunnel.sh
Restart=on-failure
RestartSec=15

[Install]
WantedBy=multi-user.target
