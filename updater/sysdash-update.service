# Voorbeeld; gebruik de begeleide installer voor rollen, modi en rechten.
# SysDash veilige auto-update (met hold-respect) — systemd unit. Installer vult /opt/sysdash in.
# Draait bewust als root (geen User=): apt-get/apt-mark/flatpak hebben systeembrede rechten nodig.
[Unit]
Description=SysDash veilige auto-update (met hold-respect)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sysdash
EnvironmentFile=/etc/sysdash/sysdash.env
ExecStart=/opt/sysdash/.venv/bin/python /opt/sysdash/updater/update.py
